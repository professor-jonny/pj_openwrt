config usteer 'adults'
    option network 'adults_lan'
    list ssid_list 'Adults2.4G'
    list ssid_list 'Adults_5.0g'
    option syslog '1'
    option local_mode '0'
    option debug_level '1'
    option remote_update_interval '1000'
    option remote_node_timeout '10'
    option max_neighbor_reports '8'
    option band_steering_threshold '5'
    option band_steering_interval '60000'
    option band_steering_min_snr '-65'

    # Load balancing
    option load_balancing_threshold '5'

config usteer 'kids'
    option network 'kids_lan'
    list ssid_list 'Kids2.4g'
    list ssid_list 'Kids_5.0g'
    option syslog '1'
    option local_mode '0'
    option debug_level '1'
    option remote_update_interval '1000'
    option remote_node_timeout '10'
    option max_neighbor_reports '8'
    option band_steering_threshold '5'
    option band_steering_interval '60000'
    option band_steering_min_snr '-65'
    option load_balancing_threshold '5'
